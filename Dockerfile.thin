# syntax=docker/dockerfile:1.7-labs

# Multi-stage build for Vector with custom features (thin build)
FROM docker.io/rust:1.87-bookworm AS chef-base

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libssl-dev \
    libsasl2-dev \
    pkg-config \
    protobuf-compiler \
    libprotobuf-dev \
    llvm-dev \
    libclang-dev \
    clang \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /vector

ENV CARGO_HOME=/usr/local/cargo \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    CARGO_INCREMENTAL=0

# Install cargo-chef once and reuse it in later stages.
RUN --mount=type=cache,id=vector-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=vector-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    cargo install cargo-chef --locked

# Build with specific features only (thin build)
ENV CARGO_FEATURES="api,enrichment-tables,transforms,secrets,unix,\
sources-file,sources-http_server,sources-http_client,sources-kafka,\
sources-internal_logs,sources-internal_metrics,sources-vector,\
sinks-clickhouse,sinks-file,sinks-http,sinks-kafka,\
sinks-aws_cloudwatch_logs,sinks-aws_cloudwatch_metrics,\
sinks-console,sinks-datadog_logs,sinks-datadog_metrics,\
sinks-blackhole,sinks-vector,sinks-prometheus"

# Compute dependency recipe from manifests.
FROM chef-base AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Compile dependencies from recipe. This layer is cached until manifests change.
FROM chef-base AS deps
COPY --from=planner /vector/recipe.json /vector/recipe.json
RUN --mount=type=cache,id=vector-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=vector-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=vector-target,target=/vector/target,sharing=locked \
    cargo chef cook --release --locked --recipe-path recipe.json --no-default-features --features "${CARGO_FEATURES}"

# Build app using cached dependencies.
FROM chef-base AS builder
COPY . .
RUN --mount=type=cache,id=vector-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=vector-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=vector-target,target=/vector/target,sharing=locked \
    cargo build --release --locked --bin vector --no-default-features --features "${CARGO_FEATURES}" \
    && install -D /vector/target/release/vector /vector/vector-bin

# Runtime stage
FROM docker.io/debian:bookworm-slim

LABEL org.opencontainers.image.description="Vector thin build with custom features"

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libsasl2-2 \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /vector/vector-bin /usr/bin/vector

# Smoke test
RUN ["/usr/bin/vector", "--version"]

ENTRYPOINT ["/usr/bin/vector"]
